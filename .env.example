APP_NAME=CyberGuard
APP_ENV=local
APP_KEY=base64:REPLACEME_RUN_php_artisan_key_generate
APP_DEBUG=true
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── BASE DE DONNEES ────────────────────────────
# Option 1: SQLite (demarrage local rapide)
DB_CONNECTION=sqlite
# DB_DATABASE=/chemin/vers/le/projet/database/database.sqlite

# Option 2: MySQL
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cyberguard
# DB_USERNAME=root
# DB_PASSWORD=

# ── SESSION / CACHE ───────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# ── MAIL OTP ──────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@cyberguard.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── CYBERGUARD ────────────────────────────────
ALARM_THRESHOLD=high
DETECTION_INTERVAL=5
DEMO_AUTO_ATTACKS=false
DEMO_ATTACK_RATE=30
HONEYPOT_ENABLED=true
HONEYPOT_LOG_ALL=true
HONEYPOT_DEMO_MODE=false
HONEYPOT_ALERT_EMAIL=
GEO_PROVIDER=local
GEO_API_KEY=
CYBERGUARD_AUTO_BLOCK_ENABLED=true
CYBERGUARD_AUTO_BLOCK_SIMULATIONS=false
CYBERGUARD_AUTO_BLOCK_ALLOWLIST=127.0.0.1,::1
CYBERGUARD_TRUSTED_ADMIN_IPS=127.0.0.1,::1
CYBERGUARD_MINI_SITE_REFRESH_ON_SEED=true

# Valeurs recommandees sur VPS :
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://votre-domaine.tld
# SESSION_SECURE_COOKIE=true
# LOG_LEVEL=info

VITE_APP_NAME="${APP_NAME}"
