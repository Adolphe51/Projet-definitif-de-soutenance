@startuml CyberGuardSequenceControleAcces
autonumber
title Sequence de controle d'acces - IP, session, role et audit

actor "Utilisateur" as User
participant "Interface Web" as UI
participant "Middleware secure" as Secure
participant "CheckBlockedIp" as BlockedMW
participant "SecuritySessionMiddleware" as SessionMW
participant "SecuritySessionService" as SessionService
participant "CheckIpAuthorized" as IpMW
participant "RequireRole" as RoleMW
participant "AuditServiceWrapper" as Audit
participant "Base de donnees" as DB
participant "Controleur cible" as Controller

User -> UI : acceder a une ressource protegee
UI -> Secure : requete HTTP + cookie access_token

Secure -> BlockedMW : verifier IP bloquee
alt IP bloquee
  BlockedMW -> Audit : journaliser refus
  BlockedMW --> UI : acces refuse
else IP non bloquee
  Secure -> SessionMW : valider la session
  SessionMW -> SessionService : validateSession(token, request)
  SessionService -> DB : lire SecuritySession + User + roles
  DB --> SessionService : session

  alt session absente, expiree ou invalide
    SessionMW -> Audit : journaliser refus
    SessionMW --> UI : redirection login / 401
  else session valide
    Secure -> IpMW : verifier IP autorisee

    alt IP non autorisee
      IpMW -> Audit : journaliser refus IP
      IpMW --> UI : 403
    else IP conforme
      Secure -> RoleMW : verifier role requis
      RoleMW -> DB : verifier user_roles
      DB --> RoleMW : admin / compte mini site

      alt role insuffisant
        RoleMW -> Audit : journaliser refus role
        RoleMW --> UI : 403
      else role autorise
        Secure -> Controller : transmettre la requete
        Controller -> Audit : journaliser acces autorise
        Controller --> UI : reponse metier
      end
    end
  end
end

note right of IpMW
  Le projet combine :
  - verification de session
  - controle d'IP
  - role utilisateur
  Ce controle contextuel renforce le RBAC.
end note

@enduml
