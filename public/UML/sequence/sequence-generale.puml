@startuml CyberGuardSequenceAcademique
autonumber
title Sequence de detection, supervision et reponse de CyberGuard

actor "Utilisateur" as User
actor "Administrateur SOC" as Admin

participant "Module applicatif\nde demonstration" as App
participant "Service de\njournalisation" as Audit
participant "Moteur de\ndetection" as Detect
participant "Service de reponse\nautomatique" as Response
participant "Base de donnees\nsecurite" as DB
participant "Interface de\nsupervision SOC" as SOC

User -> App : effectuer une action metier
App -> Audit : transmettre l'evenement
Audit -> DB : enregistrer l'audit

Audit -> Detect : analyser l'evenement

alt activite suspecte detectee

Detect -> DB : enregistrer attaque
Detect -> DB : generer alerte

Detect -> Response : evaluer la menace

alt seuil critique atteint
    Response -> DB : enregistrer blocage IP
    Response -> DB : mettre a jour incident
else menace non critique
    Response --> Detect : aucune action defensive
end

else aucune menace detectee

Detect --> Audit : archiver l'evenement

end

Admin -> SOC : consulter alertes et incidents
SOC -> DB : lire les donnees de securite
DB --> SOC : retourner les donnees consolidees
SOC --> Admin : afficher incidents et priorites

@enduml
