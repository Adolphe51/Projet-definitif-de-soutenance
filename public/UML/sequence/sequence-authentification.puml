@startuml CyberGuardSequenceAuthentification
autonumber
title Sequence d'authentification - email, mot de passe, OTP et session securisee

actor "Utilisateur" as User
participant "Interface Web" as UI
participant "LoginController" as Login
participant "AuthenticationLoggingService" as AuthLog
participant "OTPService" as OTP
participant "SecuritySessionService" as SessionService
participant "Base de donnees" as DB
participant "Service Mail" as Mail

User -> UI : saisir email + mot de passe
UI -> Login : POST /otp/send

Login -> DB : rechercher User par email
DB --> Login : utilisateur

alt identifiants invalides
  Login -> AuthLog : journaliser echec
  Login --> UI : erreur d'authentification
else identifiants valides
  Login -> AuthLog : journaliser succes etape 1
  Login -> OTP : sendOtp(email, request)
  OTP -> DB : invalider anciens codes
  OTP -> DB : creer AuthCode
  OTP -> Mail : envoyer OTP
  OTP --> Login : OTP envoye
  Login --> UI : redirection vers /otp/verify

  User -> UI : saisir le code OTP
  UI -> Login : POST /otp/verify
  Login -> OTP : verifyOtp(email, code, request)
  OTP -> DB : lire AuthCode valide

  alt code invalide ou expire
    OTP -> AuthLog : journaliser echec OTP
    OTP --> Login : refus
    Login --> UI : message d'erreur
  else code valide
    OTP -> DB : marquer AuthCode comme utilise
    Login -> AuthLog : journaliser succes OTP
    Login -> SessionService : createSession(user, request)
    SessionService -> DB : creer SecuritySession
    SessionService --> Login : access_token + refresh_token
    Login --> UI : cookie access_token + redirection dashboard
  end
end

@enduml
