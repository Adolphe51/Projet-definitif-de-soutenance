@startuml CyberGuardDeployment
top to bottom direction
skinparam shadowing false
skinparam componentStyle rectangle

title Diagramme de deploiement - CyberGuard

node "Poste utilisateur SOC" as SocClient {
  artifact "Navigateur Web\nAdministrateur" as SocBrowser
}

node "Poste utilisateur metier" as BizClient {
  artifact "Navigateur Web\nMini site metier" as BizBrowser
}

node "Poste / VM d'attaque" as ThreatNode {
  artifact "Navigateur, curl,\nsqlmap, scripts, VM reseau" as ThreatTool
}

cloud "Internet / reseau" as Network

node "VPS CyberGuard" as VpsNode {
  component "Nginx + TLS" as ReverseProxy
  component "Laravel 12 + PHP-FPM" as LaravelApp
  component "Middlewares securite\nCSRF / Session / IP / Role / Audit" as SecurityLayer
  component "Services applicatifs\nOTP / Detection / AutoBlock / Geo / Audit" as DomainServices
  component "Assets Vite\nCSS + JS compiles" as FrontAssets
  component "Cron + Laravel Scheduler" as Scheduler
  component "Honeypot secondaire\n/admin / phpmyadmin" as HoneypotArea
}

node "Donnees" as DataNode {
  database "MySQL (prod)\nSQLite (dev/demo)" as DB
}

node "Service mail OTP" as MailNode {
  component "SMTP transactionnel" as Mailer
}

cloud "API Geo optionnelle" as GeoApi

SocBrowser --> Network
BizBrowser --> Network
ThreatTool --> Network

Network --> ReverseProxy : HTTPS
ReverseProxy --> LaravelApp
LaravelApp --> SecurityLayer
SecurityLayer --> DomainServices
LaravelApp --> DB
DomainServices --> DB
DomainServices --> Mailer : envoi OTP
DomainServices --> GeoApi : lookup IP
FrontAssets --> SocBrowser
FrontAssets --> BizBrowser

ThreatTool --> HoneypotArea : routes pieges publiques
HoneypotArea --> SecurityLayer

Scheduler --> LaravelApp : schedule:run

note right of VpsNode
  Cible recommandee sur VPS :
  - APP_ENV=production
  - APP_DEBUG=false
  - HTTPS obligatoire
  - cookies securises
  - scheduler par cron
end note

note bottom of Scheduler
  Le scheduler sert surtout a :
  - l'auto-blocage periodique
  - la maintenance
  - le nettoyage des anciennes donnees
end note

note bottom of DataNode
  Tables principales :
  users, security_sessions, auth_codes,
  usagers, services, rattachements,
  messages internes,
  attacks, alerts, blocked_ips,
  attack_comments, simulations,
  detection_rules, audit_logs,
  honeypot_traps, honeypot_interactions
end note

@enduml
